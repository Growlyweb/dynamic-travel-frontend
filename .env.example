# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Display name used across the UI
VITE_APP_NAME="Travel Dashboard"

# When true, the app runs without a backend: auth is stubbed and API calls
# return demo data so every screen can be explored. Set to false in real use.
VITE_ENABLE_MOCKS=true
