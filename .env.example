# Base URL of the backend API, with no trailing slash. There is no default: the app stops at start-up without it.
VITE_API_BASE_URL=http://localhost:5000/api

# Display name used across the UI
VITE_APP_NAME="Travel Dashboard"

# Modules that still show demo data because their backend is not built yet, separated by commas.
# Use "all" to run the whole dashboard on demo data with no backend.
# Names that still need it: vendorServices, marketing, notifications, documents (the all-documents list), dashboard (home numbers), b2bOperations (partner pickups, commissions, withdrawals)
VITE_MOCK_MODULES=vendorServices,marketing,notifications,documents,dashboard,b2bOperations
